[Unit]
Description=Hangeul Swipji durable GitHub work-request ingest (pilot)
After=network-online.target
Wants=network-online.target
RequiresMountsFor=/var/lib/hangeul-swipji
AssertPathIsMountPoint=/var/lib/hangeul-swipji

[Service]
Type=oneshot
User=hangeul-worker
WorkingDirectory=/opt/hangeul-swipji-controller
EnvironmentFile=/etc/hangeul-swipji/queue-sync.env
Environment=PYTHONPATH=/opt/hangeul-swipji-controller/automation
ExecStart=/usr/bin/python3 -u /opt/hangeul-swipji-controller/automation/work_request_worker.py
TimeoutStartSec=120
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/hangeul-swipji
ProtectHome=true
UMask=0077
